* text=auto

# Repository text files use LF on every operating system.
*.py text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mako text eol=lf
*.sh text eol=lf

# Native PowerShell scripts use Windows line endings.
*.ps1 text eol=crlf
